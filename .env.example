# Copy to .env.local for local development; private env files are ignored by Git.
# Set these values in your hosting provider for production, then rebuild.
# Never put passwords or API tokens in NEXT_PUBLIC_* variables.

# Production website HTTPS origin (not the GitHub repository URL).
# Leave blank until a production domain is selected.
NEXT_PUBLIC_SITE_URL=
# Enable only after production content review; previews default to noindex.
SITE_INDEXABLE=false
# The three sample journal articles remain noindex until approved.
PUBLISH_JOURNAL_ARTICLES=false

# Optional GA4 web stream measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Content value from Search Console's HTML verification meta tag.
GOOGLE_SITE_VERIFICATION=
# Public Calendly booking event URL.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/avarvarei-catalin/30min
